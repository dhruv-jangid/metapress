{
  "name": "metapress",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tiptap/core": "latest",
      "typescript": "npm:typescript@rc",
      "zod": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "start": "turbo start",
    "build": "turbo build",
    "build:web": "turbo -F web build",
    "build:server": "turbo -F server build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @metapress/db db:push",
    "db:studio": "turbo -F @metapress/db db:studio",
    "db:generate": "turbo -F @metapress/db db:generate",
    "db:migrate": "turbo -F @metapress/db db:migrate",
    "db:start": "turbo -F @metapress/db db:start",
    "db:watch": "turbo -F @metapress/db db:watch",
    "db:stop": "turbo -F @metapress/db db:stop",
    "db:down": "turbo -F @metapress/db db:down",
    "check": "oxlint && oxfmt --write",
    "cache:flush": "turbo -F server cache:flush",
    "cache:warmup:likes": "turbo -F server cache:warmup:likes",
    "cache:warmup:usernames": "turbo -F server cache:warmup:usernames",
    "clean": "bun run scripts/clean.ts",
    "in": "bun i && bun update --recursive && bun update --recursive -i"
  },
  "devDependencies": {
    "@metapress/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "turbo": "^2.9.18",
    "typescript": "^7.0.1-rc"
  },
  "overrides": {
    "kysely": "^0.28.17"
  },
  "packageManager": "bun@1.3.14"
}
