{
  "name": "@metapress/db",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./schema": {
      "import": "./src/modules/schema.ts"
    },
    "./auth": {
      "import": "./src/modules/auth/repository.ts"
    },
    "./blogs": {
      "import": "./src/modules/blogs/repository.ts"
    },
    "./comments": {
      "import": "./src/modules/comments/repository.ts"
    },
    "./likes": {
      "import": "./src/modules/likes/repository.ts"
    },
    "./users": {
      "import": "./src/modules/users/repository.ts"
    },
    "./utils": {
      "import": "./src/lib/unique-violation.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@metapress/contracts": "workspace:*",
    "@metapress/env": "workspace:*",
    "@metapress/logger": "workspace:*",
    "@sapphire/snowflake": "^3.5.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@metapress/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  }
}
